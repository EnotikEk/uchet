# Скопируйте этот файл в .env и заполните значения.
# .env в репозиторий НЕ коммитится (см. .gitignore).

# Секретный ключ для подписи cookie-сессий.
# ОБЯЗАТЕЛЬНО задайте постоянное случайное значение и больше не меняйте его:
# при смене ключа все пользователи молча разлогиниваются.
# Сгенерировать:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Путь к файлу базы данных.
# На сервере храните БД ВНЕ каталога с кодом, чтобы git pull её не трогал.
DATABASE_PATH=/var/lib/uchet/db.db

# Хост и порт для waitress (см. server.py)
HOST=0.0.0.0
PORT=5000
